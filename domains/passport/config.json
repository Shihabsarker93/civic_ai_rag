{
  "data": {
    "processed_faq_path": "domains/passport/data/processed/passport_rag_clean.json",
    "chunk_output_path": "domains/passport/data/interim/passport_faq_chunks.jsonl",
    "chroma_persist_dir": "domains/passport/data/processed/chroma_passport_bge_m3",
    "collection_name": "passport_faq_chunks"
  },
  "embedding": {
    "provider": "sentence_transformers",
    "model": "BAAI/bge-m3",
    "device": "cpu",
    "normalize_embeddings": true,
    "local_files_only": true
  },
  "retrieval": {
    "top_k_dense": 10,
    "top_k_bm25": 10,
    "top_k_final": 8,
    "rrf_k": 50,
    "rrf_weights": {
      "dense": 0.6,
      "bm25": 0.4
    }
  },
  "reranking": {
    "enabled": true,
    "model": "BAAI/bge-reranker-v2-m3",
    "device": "cpu",
    "local_files_only": true,
    "top_k": 5,
    "fallback": "lexical_overlap"
  },
  "generation": {
    "ollama_base_url": "http://localhost:11434",
    "default_model": "llama3.2",
    "comparison_models": [
      "llama3.2",
      "llama3",
      "qwen2.5:7b"
    ],
    "temperature": 0.1,
    "top_p": 0.9,
    "num_predict": 512
  }
}
